PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_CUSTOMERS=Customers
AIRTABLE_TABLE_ORDERS=Order_2026
AIRTABLE_TABLE_ORDER_ITEMS=Order Items
AIRTABLE_TABLE_QUOTES=Quotes

# Owner-only pages and internal quote actions
ADMIN_USERNAME=lks
ADMIN_PASSWORD=choose_a_strong_private_password
SESSION_SECRET=generate_a_separate_random_secret_at_least_32_bytes

# Public links use expiring 256-bit v2 tokens. Maximum supported value: 3650 days.
PUBLIC_TOKEN_TTL_DAYS=3650

# Natural-language Quote Write Pilot (server-side only; never expose to agents)
QUOTE_PILOT_API_KEY=generate_a_long_random_secret
QUOTE_PILOT_CONFIRMATION_SECRET=generate_a_different_long_random_secret

# Optional quotation-image storage. Feature remains off unless explicitly enabled.
QUOTATION_IMAGE_ENABLED=false
QUOTATION_IMAGE_STORAGE_PROVIDER=
# For google_drive, authorize one human owner's My Drive using the drive.file scope.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_EXPECTED_OWNER_EMAIL=
GOOGLE_DRIVE_QUOTATION_IMAGE_FOLDER_ID=
QUOTATION_IMAGE_PROXY_SIGNING_SECRET=
QUOTATION_IMAGE_PROXY_TTL_SECONDS=300
# Exact HTTPS configurator URL (no query/fragment/credentials), for example
# https://lksdisplaybox.online/configurator/. The remote configurator must
# explicitly allow this Quote origin to frame it.
QUOTATION_IMAGE_RENDERER_URL=

# Company Information
# Leave these blank to use LKS defaults below
COMPANY_NAME=LKS Display Box
COMPANY_PHONE=68983722
COMPANY_EMAIL=lksdisplaybox@gmail.com
